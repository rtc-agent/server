# RTC Agent 本地开发配置模板
# 复制此文件为 config.yaml 并修改: cp etc/config.yaml.example etc/config.yaml
#
# 配置优先级（从高到低）:
#   1. 环境变量 (如 LLM__API_KEY)
#   2. 此文件 (etc/config.yaml)
#   3. 代码默认值
#
# 敏感字段（如 api_key、password）建议通过环境变量配置

server:
  host: "127.0.0.1"
  port: 8888
  env: "development"  # "development" 或 "production"

database:
  dsn: "postgres://localhost:5432/rtc_agent?sslmode=disable"
  auto_migrate: true

redis:
  addr: "localhost:6379"
  password: ""
  db: 0

log:
  level: "debug"  # debug, info, warn, error
  llm_payload: true  # 是否记录 LLM 请求/响应详情

auth:
  jwt_secret: "${AUTH__JWT_SECRET}"
  access_token_ttl_seconds: 3600

# OAuth2 Providers (至少启用一个)
providers:
  mock:
    enabled: true  # 仅开发环境使用
    url: "http://localhost:10060"
    client_id: "test-client"
    client_secret: "${PROVIDERS__MOCK__CLIENT_SECRET}"
  github:
    enabled: false
    client_id: "${PROVIDERS__GITHUB__CLIENT_ID}"
    client_secret: "${PROVIDERS__GITHUB__CLIENT_SECRET}"
  google:
    enabled: false
    client_id: "${PROVIDERS__GOOGLE__CLIENT_ID}"
    client_secret: "${PROVIDERS__GOOGLE__CLIENT_SECRET}"

cors:
  allow_origins: ["http://localhost:3000", "http://localhost:5173"]

# LLM 配置
llm:
  provider: "claude"  # claude, openai, qwen
  # api_key 通过环境变量 LLM__API_KEY 配置
  model: "claude-sonnet-4-20250514"
  max_tokens: 8192
  # reasoning_effort: "medium"  # 仅 OpenAI reasoning 模型: low, medium, high
  # retry_max_attempts: 3
  # retry_base_delay: 1s

# Worker 配置
worker:
  context_tokens_limit: 180000
  auto_compact_buffer_tokens: 20000
  token_counter_mode: "heuristic"  # heuristic 或 tokenizer

# API 配置
api:
  query_default_limit: 50
  query_max_limit: 100

# Debug 端点 (生产环境务必禁用)
debug:
  enabled: false
  # user: "admin"
  # password: "${DEBUG__PASSWORD}"

# Metrics 端点 (Prometheus)
metrics:
  # user: "admin"
  # password: "${METRICS__PASSWORD}"

# Web Search (可选)
web_search:
  enabled: false
  # providers:
  #   - name: tavily
  #     api_key: "${TAVILY_API_KEY}"

# Web Fetch (可选)
web_fetch:
  enabled: true
  global_rps: 20
  domain_rps: 5

# OSS3 对象存储 (可选 - 留空 storage.backend 禁用)
storage:
  backend: ""  # "minio" 启用, 留空禁用
  # encryption:
  #   session_token_key: "${STORAGE__ENCRYPTION__SESSION_TOKEN_KEY}"
