# RTC Agent 环境变量配置模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env
#
# 环境变量命名规则：
#   - 大写字母 + 双下划线分隔层级（对应 YAML 配置的层级结构）
#   - 示例：llm.api_key → LLM__API_KEY，database.dsn → DATABASE__DSN
#   - 这种映射由 Viper 的 SetEnvKeyReplacer(".", "__") 实现
#
# 优先级（从高到低）：
#   1. 配置文件（etc/config.yaml 或通过 --config 指定的文件）
#   2. 环境变量（如 LLM__API_KEY）
#   3. 默认值（代码中 SetDefault 设置）
#
# 注意：如果 YAML 配置文件中明确写了某个字段，环境变量不会覆盖它。
# 因此敏感字段（如 api_key、password）建议不在 YAML 中写明文，
# 而是通过环境变量配置。

# ===========================================================================
# LLM 配置（必需）
# ===========================================================================
# API Key，从模型提供商获取（如 Anthropic、OpenAI、阿里云等）
LLM__API_KEY=your-api-key-here

# ===========================================================================
# GitHub OAuth2 配置（可选）
# 申请地址: https://github.com/settings/developers
# ===========================================================================
PROVIDERS__GITHUB__ENABLED=false
PROVIDERS__GITHUB__CLIENT_ID=your-github-client-id
PROVIDERS__GITHUB__CLIENT_SECRET=your-github-client-secret

# ===========================================================================
# Google OAuth2 配置（可选）
# 申请地址: https://console.cloud.google.com/apis/credentials
# ===========================================================================
PROVIDERS__GOOGLE__ENABLED=false
PROVIDERS__GOOGLE__CLIENT_ID=your-google-client-id
PROVIDERS__GOOGLE__CLIENT_SECRET=your-google-client-secret

# ===========================================================================
# 数据库配置（可选，覆盖 config.yaml 中的默认值）
# ===========================================================================
# DATABASE__DSN=postgres://user:password@localhost:5432/rtc_agent?sslmode=disable

# ===========================================================================
# Redis 配置（可选，覆盖 config.yaml 中的默认值）
# ===========================================================================
# REDIS__ADDR=localhost:6379
# REDIS__PASSWORD=your-redis-password

# ===========================================================================
# Web Search 配置（可选）
# ===========================================================================
# Tavily API Key（当使用 tavily 搜索引擎时需要）
# 申请地址: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key

